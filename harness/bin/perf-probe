# ---------------- 主流程 ----------------
run_twosample() {
  local mode="$1" raw
  say "=========== perf-probe $mode（采样 ${S}s，双采样差分） ==========="
  if (( demo == 1 )); then
    say "  [demo 模拟数据，零 adb 调用，非真实测量]"
  else
    say "  设备: $ANDROID_SERIAL"
  fi
  if ! raw="$(collect "$mode" "$S" 0 0)"; then return 1; fi
  if ! grep -q '^SNAP A' <<<"$raw" || ! grep -q '^SNAP B' <<<"$raw"; then
    say "FAIL  采集输出异常（缺 SNAP 标记），不能当作无数据" >&2
    return 1
  fi
  local out rc
  case "$mode" in
    probe)   out="$(printf '%s\n' "$raw" | fmt_probe "$S")" ;;
    snap)    out="$(printf '%s\n' "$raw" | fmt_snap "$S")" ;;
    rank)    out="$(printf '%s\n' "$raw" | fmt_rank "$S")" ;;
    threads) out="$(printf '%s\n' "$raw" | fmt_threads "$S")" ;;
    irq)     out="$(printf '%s\n' "$raw" | fmt_irq "$S")" ;;
  esac
  rc=$?
  if (( rc != 0 )); then
    if [[ "$out" == NODATA ]]; then
      say "FAIL  解析无数据（/proc/stat 等不可读？查询失败≠无数据）" >&2
    else
      [[ -n "$out" ]] && say "$out"
      say "FAIL  采集/解析失败" >&2
    fi
    return 1
  fi
  [[ -n "$out" ]] && say "$out"
  return 0
}

run_trend() {
  local raw out
  say "=========== perf-probe trend（${N} 点 × ${IV}s，CSV） ==========="
  if (( demo == 1 )); then
    say "  [demo 模拟数据，零 adb 调用，非真实测量]" >&2
  else
    say "  设备: $ANDROID_SERIAL   预计耗时 ≈ $((N * IV))s"
  fi
  if ! raw="$(collect trend 0 "$N" "$IV")"; then return 1; fi
  if ! grep -q '^POINT 0' <<<"$raw"; then
    say "FAIL  采集输出异常（缺 POINT 标记），不能当作无数据" >&2
    return 1
  fi
  if ! out="$(printf '%s\n' "$raw" | run_trend_fmt)"; then
    say "FAIL  trend 解析失败" >&2
    return 1
  fi
  say "$out"
  return 0
}

case "$cmd" in
  probe|snap|rank|threads|irq) run_twosample "$cmd" ;;
  trend) run_trend ;;
esac
