# =============================================================================
# harness.conf —— 本文件是唯一需要人工维护的配置
#
# 用法：
#   cp harness.conf.example harness.conf
#   编辑下面的 ROOTS / ALIASES，然后 bash features/.harness/bootstrap.sh
#
# 位置：安装后位于 <源码树>/features/harness.conf
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 源码树根
# -----------------------------------------------------------------------------
# 留空 = 自动推导（<树>/features/.harness/lib/../../.. 就是树根）。
# 只有把 harness 放在树外时才需要显式指定。
HARNESS_TREE=""

# -----------------------------------------------------------------------------
# 2. 要建 codegraph 库的目录（**由你决定**）
# -----------------------------------------------------------------------------
# 相对树根的一级目录。每个目录对应**一个独立库**（各自 .codegraph/），不共享。
# 也可以用 `bash features/.harness/bin/cg-roots add <dir>` 增删，避免手改语法。
#
# 选根原则：
#   - 一个根 = 一次独立索引 + 一个独立 projectPath；根越少，单库越大、越慢；
#   - 常用改动的目录单独成根（例如 kernel / frameworks），冷门大目录可以合并；
#   - 目录必须真实存在于该树，否则 cg-build 会 SKIP。
ROOTS=(
  "kernel"
  "frameworks"
  "system"
  "hardware"
  "vendor"
  "device/<vendor>"
)

# -----------------------------------------------------------------------------
# 3. 别名（同一份源码的第二个入口名）
# -----------------------------------------------------------------------------
# 格式 "别名=真实目录"。别名行只做路由，不额外建库。
# 典型场景：目录带版本号（kernel-5.10），但代码里习惯写 kernel/。
ALIASES=(
  # "kernel=kernel-5.10"
)

# -----------------------------------------------------------------------------
# 4. 索引排除策略（由 cg-exclude 使用）
# -----------------------------------------------------------------------------
# 注意：以下全是**候选**。cg-exclude 会先探测该根下是否真的存在，
# 只把确实存在的条目写进 codegraph.json —— 写不存在的规则等于没写。

# 4.1 目录名候选
EXCLUDE_DIR_CANDIDATES=(
  "out" "output" "build" ".out" "obj" "gen" "generated"
  "prebuilts" "third_party" "node_modules" ".gradle" ".cache"
  "test" "tests" "testing" "vts" "cts" "samples" "demo" "benchmarks"
  "docs" "documentation"
)

# 4.2 文件模式候选：探测到该扩展名存在才写入
EXCLUDE_FILE_PATTERNS=(
  "**/*.o" "**/*.a" "**/*.so" "**/*.d" "**/*.cmd" "**/*.mod.c"
  "**/*.min.js" "**/*.min.css" "**/*.pb.cc" "**/*.pb.h"
  "**/*_gen.cpp" "**/*_gen.h" "**/*.gcda" "**/*.gcno"
)

# 4.3 每个根额外追加的排除（gitignore 风格，相对根目录）。示例：
#   EXTRA_EXCLUDE=("arch/mips/**" "arch/powerpc/**")
EXTRA_EXCLUDE=()

# 4.4 探测深度：默认只看 3 层目录 / 4 层文件（大树上很快）。
#     cg-exclude --deep 会全量遍历，慢但更准。
EXCLUDE_SCAN_DEPTH_DIR=3
EXCLUDE_SCAN_DEPTH_FILE=4

# -----------------------------------------------------------------------------
# 5. codegraph 工具
# -----------------------------------------------------------------------------
# 低于该版本会在 bootstrap 中提示升级
CODEGRAPH_MIN_VERSION="1.6.0"

# 需要注册 MCP 的客户端（逗号分隔）。留空 = 交给 `codegraph install -t auto`
# 可选 id：claude,opencode,cursor,codex,gemini,...（以 `codegraph install --help` 为准）
CODEGRAPH_MCP_TARGETS=""

# -----------------------------------------------------------------------------
# 6. 索引执行
# -----------------------------------------------------------------------------
# 1 = 串行（共享磁盘 / SMB / NFS 上强烈建议）；并行会争抢 IO 且日志难归因
BUILD_SERIAL=1
